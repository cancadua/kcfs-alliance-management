{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Key": "",
    "Issuer": "AllianceRewards",
    "Audience": "AllianceRewards",
    "ExpiryMinutes": 1440
  },
  "Cors": {
    "Origins": [ "https://cancadua.github.io" ]
  },
  "RateLimit": {
    "Auth": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Link": { "PermitLimit": 10, "WindowSeconds": 300 },
    "SharedMapCreate": { "PermitLimit": 10, "WindowSeconds": 3600 },
    "SharedMap": { "PermitLimit": 300, "WindowSeconds": 60 }
  },
  "SharedMaps": {
    "LifetimeHours": 4,
    "MaxStateBytes": 65536
  },
  "LinkCodes": {
    "ValidDays": 7
  }
}
